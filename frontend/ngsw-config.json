{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/favicon.ico", "/manifest.webmanifest", "/main-*.js", "/styles-*.css", "/s2s-logo.png", "/i18n/**/*.json"]
      }
    },
    {
      "name": "on-demand-static",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/*.js", "/*.css", "/media/**", "/icons/**"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**"]
}
